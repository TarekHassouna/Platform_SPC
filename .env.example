# 1. Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# 2. Python FastAPI + SymPy + Pint Evaluation Microservice (optional — falls back to built-in evaluator)
EVALUATION_SERVICE_URL=http://127.0.0.1:8000

# 3. AI Provider (server-side ONLY — add EITHER Claude OR Gemini key!)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
CLAUDE_VISION_MODEL=claude-3-5-sonnet-latest

# Or use Google Gemini API instead:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
